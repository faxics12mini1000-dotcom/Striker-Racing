{
  "name": "striker-racing-site",
  "private": true,
  "version": "1.0.0",
  "description": "Sitio estatico de Striker Racing (STEM Racing Mexico). El HTML se sirve tal cual; el visor 3D se empaqueta con esbuild (npm run build:viewer). Los demas scripts son utilidades de mantenimiento (vendorizar fuentes, hornear el GLB y el entorno, generar posters).",
  "scripts": {
    "vendor:three": "node scripts/vendor-three.mjs",
    "vendor:fonts": "node scripts/vendor-fonts.mjs",
    "build:viewer": "node scripts/build-viewer.mjs",
    "bake:glb": "node scripts/bake-sr26-normals.mjs",
    "bake:env": "node scripts/bake-env.mjs",
    "measure:viewer": "node scripts/measure-viewer.mjs",
    "stamp:img": "node scripts/stamp-images.mjs",
    "build:brand": "node scripts/generate-og-image.mjs",
    "build:og": "node scripts/generate-og-pages.mjs",
    "build:images": "node scripts/build-images.mjs",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "serve": "node scripts/dev-server.mjs 8099 . cache",
    "qa:reveal": "node qa/reveal.test.mjs",
    "qa:axe": "node qa/axe.mjs",
    "qa:lighthouse": "node qa/lighthouse.mjs",
    "build:facts": "node scripts/build-facts.mjs",
    "build:model": "node scripts/build-model.mjs && node scripts/build-facts.mjs && node scripts/build-viewer.mjs",
    "build:poster": "node scripts/generate-poster.mjs && node scripts/stamp-images.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@gltf-transform/cli": "^4.0.4",
    "@gltf-transform/core": "^4.0.4",
    "@gltf-transform/extensions": "^4.0.4",
    "@gltf-transform/functions": "^4.0.4",
    "@google/model-viewer": "^4.3.1",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.2",
    "esbuild": "^0.28.2",
    "gltf-validator": "^2.0.0-dev.3.10",
    "lighthouse": "^13.5.0",
    "marked": "^18.0.14",
    "meshoptimizer": "^0.22.0",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "three": "0.160.0"
  }
}
