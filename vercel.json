{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/equipo.html",
      "destination": "/#equipo",
      "permanent": true
    },
    {
      "source": "/patrocinios.html",
      "destination": "/patrocinios/",
      "permanent": true
    },
    {
      "source": "/presupuesto.html",
      "destination": "/presupuesto/",
      "permanent": true
    },
    {
      "source": "/auto.html",
      "destination": "/auto/",
      "permanent": true
    },
    {
      "source": "/en/equipo.html",
      "destination": "/en/#team",
      "permanent": true
    },
    {
      "source": "/en/patrocinios.html",
      "destination": "/en/sponsorship/",
      "permanent": true
    },
    {
      "source": "/en/presupuesto.html",
      "destination": "/en/budget/",
      "permanent": true
    },
    {
      "source": "/en/auto.html",
      "destination": "/en/car/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon-48|favicon-192|apple-touch-icon).png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/car.glb",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/car-poster.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/logo-64.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/og-share.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/cv/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*).(glb|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
